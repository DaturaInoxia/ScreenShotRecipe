@using Microsoft.AspNetCore.Components.Routing

<nav class="navbar-collapse" id="navbarNav">
    <ul class="nav flex-column">
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="recipes" Match="NavLinkMatch.All">
                <span class="bi bi-list me-2" aria-hidden="true"></span> Recipes
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="import" Match="NavLinkMatch.Prefix">
                <span class="bi bi-upload me-2" aria-hidden="true"></span> Import Recipe
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
