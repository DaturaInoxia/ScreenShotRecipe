@page "/import"
@rendermode InteractiveServer
@using ScreenShotRecipe.Application.Contracts.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<Import> Logger

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Import Recipe from Images</h1>
    <a href="/recipes" class="btn btn-outline-secondary">
      <span class="bi bi-arrow-left me-1"></span>Back to Recipes
    </a>
  </div>
  <p>Select 1-12 image files (screenshots or photos of your recipe) and click Import. <b>Will only do one recipe at a time.</b></p>

  <div class="form-group mb-3">
    <label for="fileInput">Select Images (you can add more files by selecting again):</label>
    <InputFile id="fileInput" class="form-control" multiple accept="image/*" OnChange="HandleFileSelected" disabled="@isLoadingFiles" />
  </div>

  @* File loading progress *@
  @if (isLoadingFiles)
  {
    <div class="alert alert-info d-flex align-items-center mb-3">
      <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
      <span>Loading files... @filesLoadedCount of @filesToLoadCount</span>
      <div class="progress ms-3 flex-grow-1" style="height: 8px;">
        <div class="progress-bar" role="progressbar" style="width: @GetLoadingProgress()%" aria-valuenow="@filesLoadedCount" aria-valuemin="0" aria-valuemax="@filesToLoadCount"></div>
      </div>
    </div>
  }

  @* Selected files list *@
  @if (selectedFiles.Count > 0)
  {
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>
          <strong>Ready to Import:</strong> @selectedFiles.Count file(s)
          @if (selectedFiles.Count >= 12)
          {
            <span class="badge bg-warning ms-2">Maximum reached</span>
          }
        </span>
        <button class="btn btn-sm btn-outline-danger" @onclick="ClearAllFiles" disabled="@(isLoading || isLoadingFiles)">
          Clear All
        </button>
      </div>
      <div class="card-body">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-2">
          @foreach (var file in selectedFiles)
          {
            <div class="col">
              <div class="border rounded p-2 position-relative" style="min-height: 120px;">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-1" 
                        style="font-size: 0.6rem; padding: 4px;"
                        @onclick="() => RemoveFile(file.FileName)" 
                        disabled="@(isLoading || isLoadingFiles)"
                        title="Remove this file"></button>
                @if (file.PreviewUrl != null)
                {
                  <img src="@file.PreviewUrl" alt="@file.FileName" class="img-fluid rounded mb-1" style="max-height: 80px; object-fit: contain; width: 100%;" />
                }
                else
                {
                  <div class="bg-light rounded d-flex align-items-center justify-content-center mb-1" style="height: 80px;">
                    <span class="text-muted small">Preview</span>
                  </div>
                }
                <div class="small text-truncate" title="@file.FileName">@file.FileName</div>
                <div class="small text-muted">@FormatFileSize(file.Bytes.Length)</div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  }

  <div class="form-group mb-3">
    <button class="btn btn-primary btn-lg" @onclick="HandleImport" disabled="@(!CanImport)">
      @if (isLoading)
      {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        @importStatus
      }
      else if (isLoadingFiles)
      {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        <span>Loading files...</span>
      }
      else if (selectedFiles.Count == 0)
      {
        <span>Select images to import</span>
      }
      else
      {
        <span>Import Recipe (@selectedFiles.Count image@(selectedFiles.Count > 1 ? "s" : ""))</span>
      }
    </button>
    @if (!CanImport && !isLoading && !isLoadingFiles && selectedFiles.Count == 0)
    {
      <small class="text-muted ms-2">Select at least one image to enable import</small>
    }
  </div>

  @if (!string.IsNullOrEmpty(message))
  {
    <div class="alert alert-@(isError ? "danger" : "info")" role="alert">
      @message
    </div>
  }

  @if (importResponse != null)
  {
    <div class="card mt-3 @(importResponse.Status == "Succeeded" ? "border-success" : "border-warning")">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>
          @if (importResponse.Status == "Succeeded")
          {
            <span class="badge bg-success me-2">✓ Imported</span>
          }
          else if (importResponse.Status == "Failed")
          {
            <span class="badge bg-danger me-2">✗ Failed</span>
          }
          else
          {
            <span class="badge bg-warning me-2">⏳ @importResponse.Status</span>
          }
          Import Job: @importResponse.ImportJobId.ToString()[..8]...
        </span>
        @if (importResponse.Recipe != null)
        {
          <span class="@GetConfidenceBadgeClass()">
            Confidence: @GetConfidencePercent()
          </span>
        }
      </div>
      
      <div class="card-body">
        @if (importResponse.Recipe != null)
        {
          <h4 class="card-title">@importResponse.Recipe.Title</h4>
          
          @if (!string.IsNullOrEmpty(importResponse.Recipe.Notes))
          {
            <p class="card-text text-muted">@importResponse.Recipe.Notes</p>
          }
          
          <div class="row mb-3">
            <div class="col-md-6">
              <h6>Ingredients (@importResponse.Recipe.Ingredients.Count)</h6>
              <ul class="list-group list-group-flush small">
                @foreach (var ing in importResponse.Recipe.Ingredients.Take(5))
                {
                  <li class="list-group-item py-1">@ing.RawText</li>
                }
                @if (importResponse.Recipe.Ingredients.Count > 5)
                {
                  <li class="list-group-item py-1 text-muted">...and @(importResponse.Recipe.Ingredients.Count - 5) more</li>
                }
              </ul>
            </div>
            <div class="col-md-6">
              <h6>Steps (@importResponse.Recipe.Steps.Count)</h6>
              <ol class="list-group list-group-numbered list-group-flush small">
                @foreach (var step in importResponse.Recipe.Steps.Take(3))
                {
                  <li class="list-group-item py-1">@TruncateText(step.Text, 80)</li>
                }
                @if (importResponse.Recipe.Steps.Count > 3)
                {
                  <li class="list-group-item py-1 text-muted">...and @(importResponse.Recipe.Steps.Count - 3) more steps</li>
                }
              </ol>
            </div>
          </div>
          
          @if (importResponse.ImageIds != null && importResponse.ImageIds.Count > 0)
          {
            <h6>Uploaded Images</h6>
            <div class="d-flex flex-wrap gap-2 mb-3">
              @foreach (var imageId in importResponse.ImageIds)
              {
                <div class="border rounded overflow-hidden" style="width: 100px; height: 100px;">
                  <img src="/api/images/@imageId" 
                       alt="Recipe image" 
                       class="w-100 h-100" 
                       style="object-fit: cover;"
                       onerror="this.style.display='none'" />
                </div>
              }
            </div>
          }
          
          <div class="mt-3">
            <a href="/recipe/@importResponse.Recipe.Id" class="btn btn-info">View Full Recipe</a>
            <a href="/recipes" class="btn btn-secondary ms-2">Back to List</a>
            <button class="btn btn-outline-primary ms-2" @onclick="ResetForm">Import Another</button>
          </div>
        }
        else if (!string.IsNullOrEmpty(importResponse.ErrorMessage))
        {
          <div class="alert alert-danger">
            <strong>Error:</strong> @importResponse.ErrorMessage
          </div>
          @if (!string.IsNullOrEmpty(importResponse.Diagnostics))
          {
            <details class="mt-2">
              <summary class="text-muted small">Diagnostics</summary>
              <pre class="small bg-light p-2 mt-1">@importResponse.Diagnostics</pre>
            </details>
          }
          <button class="btn btn-primary mt-2" @onclick="HandleImport">Retry Import</button>
        }
      </div>
    </div>
  }
</div>

@code {
  private record SelectedFile(byte[] Bytes, string FileName, string? PreviewUrl);
  
  private List<SelectedFile> selectedFiles = new();
  private bool isLoading = false;
  private bool isLoadingFiles = false;
  private int filesLoadedCount = 0;
  private int filesToLoadCount = 0;
  private string message = string.Empty;
  private string importStatus = "Importing...";
  private bool isError = false;
  private RecipeImportResponseDto? importResponse = null;

  private bool CanImport => selectedFiles.Count > 0 && !isLoading && !isLoadingFiles;

  private int GetLoadingProgress()
  {
    if (filesToLoadCount == 0) return 0;
    return (int)((double)filesLoadedCount / filesToLoadCount * 100);
  }

  private async Task HandleFileSelected(InputFileChangeEventArgs e)
  {
    message = string.Empty;
    isError = false;
    importResponse = null;

    var files = e.GetMultipleFiles();
    var remainingSlots = 12 - selectedFiles.Count;
    
    if (remainingSlots <= 0)
    {
      message = "Maximum 12 files allowed. Remove some files to add more.";
      isError = true;
      StateHasChanged();
      return;
    }

    var filesToProcess = files.Take(remainingSlots).ToList();
    filesToLoadCount = filesToProcess.Count;
    filesLoadedCount = 0;
    isLoadingFiles = true;
    StateHasChanged();

    try
    {
      foreach (var file in filesToProcess)
      {
        // Check for duplicate filenames
        if (selectedFiles.Any(f => f.FileName == file.Name))
        {
          filesLoadedCount++;
          StateHasChanged();
          continue;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        
        // Create preview URL
        var base64 = Convert.ToBase64String(bytes);
        var mimeType = GetMimeType(file.Name);
        var previewUrl = $"data:{mimeType};base64,{base64}";
        
        selectedFiles.Add(new SelectedFile(bytes, file.Name, previewUrl));
        filesLoadedCount++;
        StateHasChanged();
        
        // Small delay to show progress smoothly
        await Task.Delay(50);
      }
      
      if (files.Count > remainingSlots)
      {
        message = $"Added {filesToProcess.Count} files. {files.Count - remainingSlots} file(s) skipped (maximum 12).";
        isError = false;
      }
    }
    catch (Exception ex)
    {
      message = $"Error loading files: {ex.Message}";
      isError = true;
    }
    finally
    {
      isLoadingFiles = false;
      filesLoadedCount = 0;
      filesToLoadCount = 0;
      StateHasChanged();
    }
  }

  private void RemoveFile(string fileName)
  {
    selectedFiles.RemoveAll(f => f.FileName == fileName);
    StateHasChanged();
  }

  private void ClearAllFiles()
  {
    selectedFiles.Clear();
    message = string.Empty;
    isError = false;
    importResponse = null;
    StateHasChanged();
  }

  private static string GetMimeType(string fileName)
  {
    var ext = Path.GetExtension(fileName).ToLowerInvariant();
    return ext switch
    {
      ".jpg" or ".jpeg" => "image/jpeg",
      ".png" => "image/png",
      ".gif" => "image/gif",
      ".webp" => "image/webp",
      ".bmp" => "image/bmp",
      _ => "image/jpeg"
    };
  }

  private async Task HandleImport()
  {
    if (selectedFiles.Count == 0)
    {
      message = "Please select at least one image.";
      isError = true;
      StateHasChanged();
      return;
    }

    isLoading = true;
    importStatus = "Uploading images...";
    message = string.Empty;
    isError = false;
    importResponse = null;
    StateHasChanged();

    try
    {
      var form = new MultipartFormDataContent();
      foreach (var file in selectedFiles)
      {
        var byteContent = new ByteArrayContent(file.Bytes);
        form.Add(byteContent, "files", file.FileName);
      }
      form.Add(new StringContent("web-upload"), "source");

      importStatus = "Processing with AI...";
      StateHasChanged();

      var baseUri = Navigation.BaseUri;
      var apiUrl = $"{baseUri}api/import";
      Logger.LogInformation("Posting to API: {ApiUrl} with {FileCount} files", apiUrl, selectedFiles.Count);
      
      var response = await Http.PostAsync(apiUrl, form);
      
      Logger.LogInformation("API Response: {StatusCode}", response.StatusCode);
      
      var content = await response.Content.ReadAsStringAsync();
      importResponse = JsonSerializer.Deserialize<RecipeImportResponseDto>(content, 
        new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
      
      if (response.IsSuccessStatusCode && importResponse?.Recipe != null)
      {
        message = string.Empty;
        isError = false;
        selectedFiles.Clear();
      }
      else if (importResponse != null)
      {
        message = importResponse.ErrorMessage ?? "Import failed";
        isError = true;
      }
      else
      {
        message = $"Import failed: {content}";
        isError = true;
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error importing recipe");
      message = $"Error importing recipe: {ex.Message}";
      isError = true;
      importResponse = null;
    }
    finally
    {
      isLoading = false;
      importStatus = "Importing...";
      StateHasChanged();
    }
  }

  private void ResetForm()
  {
    selectedFiles.Clear();
    message = string.Empty;
    isError = false;
    importResponse = null;
    StateHasChanged();
  }

  private string GetConfidenceBadgeClass()
  {
    if (importResponse?.Recipe == null) return "badge bg-secondary";
    
    // Try to parse confidence from OcrResults if available
    decimal confidence = 0.85m; // Default moderate confidence
    if (importResponse.OcrResults != null && importResponse.OcrResults.Count > 0)
    {
      confidence = importResponse.OcrResults.Average(r => r.Confidence);
    }
    
    return confidence switch
    {
      >= 0.8m => "badge bg-success",
      >= 0.5m => "badge bg-warning text-dark",
      _ => "badge bg-danger"
    };
  }

  private string GetConfidencePercent()
  {
    if (importResponse?.OcrResults != null && importResponse.OcrResults.Count > 0)
    {
      var avg = importResponse.OcrResults.Average(r => r.Confidence);
      return $"{avg:P0}";
    }
    return "~85%";
  }

  private static string FormatFileSize(long bytes)
  {
    const long KB = 1024;
    const long MB = 1024 * 1024;
    
    if (bytes < KB) return $"{bytes} B";
    if (bytes < MB) return $"{bytes / 1024.0:F1} KB";
    return $"{bytes / (1024.0 * 1024.0):F1} MB";
  }

  private static string TruncateText(string text, int maxLength)
  {
    if (string.IsNullOrEmpty(text) || text.Length <= maxLength) return text;
    return text[..(maxLength - 3)] + "...";
  }
}
