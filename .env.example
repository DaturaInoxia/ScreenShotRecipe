# ScreenShotRecipe Environment Variables
# Copy this file to .env and fill in your values (do NOT commit .env to source control)
# Use double underscore (__) for nested configuration sections

# ======================================
# Service Implementation (fake vs real)
# ======================================

# Set to "true" to use real GPT-4o extraction, "false" for fake/mock (default)
EXTRACTION_USE_REAL=false

# ======================================
# Azure OpenAI Configuration
# (Required only when EXTRACTION_USE_REAL=true)
# ======================================

# Azure OpenAI endpoint URL
# Example: https://your-resource.openai.azure.com/
AzureOpenAI__Endpoint=

# Azure OpenAI API key (from Azure portal)
AzureOpenAI__ApiKey=

# Azure OpenAI deployment name (e.g., "gpt-4o")
AzureOpenAI__DeploymentName=gpt-4o

# ======================================
# Alternative: Direct OpenAI API
# (Use instead of Azure if preferred)
# ======================================

# OpenAI API key (from platform.openai.com)
AzureOpenAI__OpenAIApiKey=

# OpenAI model name (default: gpt-4o)
AzureOpenAI__OpenAIModel=gpt-4o

# ======================================
# Optional Model Parameters
# ======================================

# Max tokens for response (default: 4096)
AzureOpenAI__MaxTokens=4096

# Temperature 0.0-2.0, lower = more deterministic (default: 0.2)
AzureOpenAI__Temperature=0.2

# Request timeout in seconds (default: 120)
AzureOpenAI__TimeoutSeconds=120

# ======================================
# Database Path (optional)
# ======================================

# Override database location (auto-detects: /data/app.db in Docker, app.db locally)
# DatabasePath=/data/app.db

# ======================================
# Image Storage Path (optional)
# ======================================

# Override image storage directory (auto-detects: /data/images in Docker, ./data/images locally)
# ImageStoragePath=/data/images
